# This file is now a template for envsubst. Use with docker-entrypoint.sh.
# NGINX config for OIDC client registration proxy with redirect_uri validation
# Requires ngx_http_lua_module (OpenResty or NGINX with Lua)

worker_processes  1;

error_log logs/error.log debug;

events {
    worker_connections 1024;
}

http {
    # List of allowed redirect_uris
    lua_shared_dict allowed_uris 1m;

    # Initialize allowed redirect_uris at startup
    init_by_lua_block {
        local allowed = {${ALLOWED_REDIRECT_URIS}}
        local dict = ngx.shared.allowed_uris
        for _, uri in ipairs(allowed) do
            dict:set(uri, true)
        end
    }

    server {
        listen ${LISTEN_PORT};
        server_name localhost;

        location /scitokens-server/oidc-cm {
            content_by_lua_block {
                ngx.req.read_body()
                local data = ngx.req.get_body_data()
                if not data then
                    ngx.status = 400
                    ngx.say("Missing request body")
                    return
                end
                local cjson = require "cjson.safe"
                local req = cjson.decode(data)
                if not req then
                    ngx.status = 400
                    ngx.say("Malformed JSON in registration request")
                    return
                end
                local grant_types = req["grant_types"]
                if not grant_types or type(grant_types) ~= "table" then
                    ngx.status = 400
                    ngx.say("Missing or invalid grant_types in registration request")
                    return
                end
                local has_auth_code = false
                local has_device_code = false
                for _, gt in ipairs(grant_types) do
                    if gt == "authorization_code" then
                        has_auth_code = true
                    elseif gt == "urn:ietf:params:oauth:grant-type:device_code" then
                        has_device_code = true
                    end
                end
                if has_auth_code then
                    -- For auth code flow, validate redirect_uris
                    if not req["redirect_uris"] then
                        ngx.status = 400
                        ngx.say("Missing redirect_uris in registration request for authorization_code flow")
                        return
                    end
                    local dict = ngx.shared.allowed_uris
                    local valid = true
                    for _, uri in ipairs(req["redirect_uris"]) do
                        if not dict:get(uri) then
                            valid = false
                            break
                        end
                    end
                    if not valid then
                        ngx.status = 400
                        ngx.say("Invalid redirect_uri for authorization_code flow")
                        return
                    end
                elseif has_device_code and not has_auth_code then
                    -- Device code only: do not constrain redirect_uris
                    -- No validation needed
                else
                    ngx.status = 400
                    ngx.say("Unsupported grant_types. Only authorization_code and device_code flows are allowed.")
                    return
                end
                -- Pass to proxy handler
                ngx.req.set_header("Content-Type", "application/json")
                ngx.exec("/valid-registration")
            }
        }

        location /valid-registration {
            internal;
            proxy_pass http://${OIDC_ISSUER_HOST}${OIDC_REGISTRATION_ENDPOINT};
            proxy_set_header Host ${OIDC_ISSUER_HOST};
            proxy_set_header X-Real-IP $${envsubst_escape}remote_addr;
            proxy_set_header X-Forwarded-For $${envsubst_escape}proxy_add_x_forwarded_for;
            proxy_pass_request_body on;
            proxy_pass_request_headers on;
        }

        # Catch-all: proxy all other requests directly
        location / {
            proxy_pass http://${OIDC_ISSUER_HOST};
            proxy_set_header Host ${OIDC_ISSUER_HOST};
            proxy_set_header X-Real-IP $${envsubst_escape}remote_addr;
            proxy_set_header X-Forwarded-For $${envsubst_escape}proxy_add_x_forwarded_for;
            proxy_pass_request_body on;
            proxy_pass_request_headers on;
        }
    }
}
